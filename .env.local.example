# ─────────────────────────────────────────────────────────────────────────────
# Kim Pelham Site — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Newsletter popup ──────────────────────────────────────────────────────────
# GHL Webhook URL for newsletter signups (popup form)
NEXT_PUBLIC_NEWSLETTER_WEBHOOK=

# ── A2P 10DLC Compliance ──────────────────────────────────────────────────────
# Legal business name — MUST match exactly what is in the GHL Brand registration
# (Trust Center → Brand). Confirm from Phase 1 audit before deploying.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME="The Pelham Group NW"

# On-site legal pages (defaults to /privacy and /terms — no override needed unless
# you want to point to a different URL)
# NEXT_PUBLIC_PRIVACY_POLICY_URL="/privacy"
# NEXT_PUBLIC_TERMS_URL="/terms"

# ── GHL Contact Form API (server-side only — NEVER prefix with NEXT_PUBLIC_) ──
# GHL Private Integration Token — get from GHL Settings → Integrations → API Keys
# NEVER commit this value. Add to Vercel environment variables (Production + Preview).
GHL_API_TOKEN=

# Kim's GHL sub-account Location ID — get from GHL Settings → Business Profile
GHL_LOCATION_ID=

# ── Analytics & Attribution ──────────────────────────────────────────────────
# All four of these are OPTIONAL — site works fine without them. Each one is
# gated by its env var, so until you fill in a value, that integration is a
# no-op. Set these in Vercel (Project → Settings → Environment Variables →
# Production) and redeploy to activate.

# Google Analytics 4 — primary traffic + behavior tracking. Captures pageviews,
# sessions, click-to-call (tel: outbound clicks), form submits, etc.
# How to get: analytics.google.com → Admin → + Create → Property. After
# creating, find the Measurement ID under Data Streams (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console verification code — proves to Google you own the
# domain so you can submit the sitemap and see organic search performance.
# How to get: search.google.com/search-console → Add Property → URL prefix:
# https://thepelhamgroupnw.com → choose "HTML tag" verification method →
# copy ONLY the value of content="..." (not the whole tag).
NEXT_PUBLIC_GSC_VERIFICATION_CODE=

# Microsoft Clarity — free heatmaps + session recordings. Shows you literally
# where people click, scroll, and drop off.
# How to get: clarity.microsoft.com → + New Project → name it → copy the
# Project ID (10-char string like "abc123def4") from Settings → Setup.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# CallRail Swap path — phone-call attribution. Replaces Kim's number on the
# page with a tracking number per source so you can see which channel drove
# which call.
# How to get: app.callrail.com → set up a Form/Visitor Tracking pool for the
# site → on the install screen, copy the script URL. The path is everything
# AFTER "//cdn.callrail.com/" — typically: companies/123456789/abcdef0123/12/swap.js
NEXT_PUBLIC_CALLRAIL_SWAP_PATH=
